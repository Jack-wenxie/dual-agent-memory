{
  "schema": "dual-agent-memory-graph-policy-example/v1",
  "example_only": true,
  "runtime_mode": "synthetic_contract_demo",
  "source_policy": {
    "explicit_manifest_required": true,
    "manifest_covers_exact_kernel_eligible_set": true,
    "kernel_live_corpus": "all_top_level_md_except_MEMORY_md_and_dot_or_underscore_names_no_subdirectories",
    "missing_or_invalid_manifest": "BLOCKED",
    "private_profile_fallback": false,
    "live_source_sync_included": false,
    "primary_sources_and_derived_mirrors_are_distinct": true,
    "semantic_schema_validation_required": true,
    "source_semantic_review_required": true
  },
  "release_policy": {
    "single_candidate_generation": true,
    "immutable_hash_bound_release": true,
    "required_marker_blocks_missing_pointer": true,
    "corrupt_pointer_legacy_fallback": false,
    "activation": "journal_then_atomic_pointer_then_marker_then_legacy_compatibility_projection",
    "legacy_projection_writes_named_flat_copies_and_archives_obsolete_chunks": true,
    "cas_required": true,
    "old_releases_retained": true,
    "external_registry_access": "caller_supplied_read_only_snapshot",
    "snapshot_is_not_emitted_by_existing_bti_companion": true,
    "data_roots_and_evidence_files": "explicit_caller_parameters"
  },
  "pending_policy": {
    "writer_policy": "append_only",
    "high_water_source": "candidate_frozen_prefix",
    "binding_fields": ["prefix_bytes", "prefix_sha256", "prefix_non_comment_count"],
    "complete_prefix_lf_boundary_required": true,
    "historical_prefix_retained": true,
    "writer_must_preserve_unconsumed_suffix": true,
    "consumer_suffix_validation": "utf8_decoding_only",
    "valid_suffix_deletion_or_rewriting_detected": false,
    "truncation_exactly_to_valid_frozen_prefix_can_be_accepted": true,
    "truncate_or_clear_log_allowed_at_writer": false
  },
  "consumer_policy": {
    "full_resolver_required": true,
    "fast_probe_authority": false,
    "briefing_is_authority": false,
    "explicit_briefing_output_directory": true,
    "cache_binding": "active_release_and_frozen_prefix",
    "valid_append_same_release_cache": "NOOP",
    "immutable_binding_failure": "BLOCKED_no_old_cache",
    "action_requires_current_source_verification": true
  },
  "maintenance_policy": {
    "numeric_values_source": "templates/thresholds.example.json:memory_graph",
    "numeric_defaults_copied_here": false,
    "pending_count_basis": "valid_unconsumed_suffix_entries_after_active_high_water",
    "pending_comparison": "greater_than_or_equal_to_shared_threshold",
    "additional_due_signal": "drifted_source_count_exceeds_unconsumed_pending_count",
    "drift_rule_is_per_file_match": false,
    "unverifiable_view_threshold_or_drift_probe": "BLOCKED_never_FRESH",
    "due_is_reminder_only": true,
    "automatic_rebuild": false,
    "fresh_means_full_coverage": false,
    "health_sync_or_drift_module_included": false
  },
  "synthetic_fixture": {
    "seed": 42,
    "source_cards": 2,
    "nodes": 6,
    "links": 6,
    "hyperedges": 3,
    "communities": 3,
    "graphify_or_llm_included": false,
    "html": "inert_placeholder_no_network_resources"
  }
}
